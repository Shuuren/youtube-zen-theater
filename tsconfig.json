{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["DOM", "ES2022"],
    "types": ["chrome", "node"],
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": true
  },
  "include": [
    "src/**/*.js",
    "popup/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": ["tools/oxlint/anti-slop/**"]
}
